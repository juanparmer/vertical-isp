<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_isp_network_node_tree" model="ir.ui.view">
        <field name="name">isp.network.node.tree</field>
        <field name="model">isp.network.node</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="node_type" />
                <field name="parent_id" />
                <field name="city_id" />
                <field name="state_id" />
                <field name="capacity" />
            </list>
        </field>
    </record>

    <record id="view_isp_network_node_form" model="ir.ui.view">
        <field name="name">isp.network.node.form</field>
        <field name="model">isp.network.node</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="active" invisible="1" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                        <field name="code" placeholder="Node code" />
                    </div>
                    <group>
                        <group>
                            <field name="node_type" />
                            <field name="parent_id" />
                            <field name="capacity" />
                        </group>
                        <group>
                            <field name="city_id" />
                            <field name="state_id" />
                            <field name="latitude" />
                            <field name="longitude" />
                        </group>
                    </group>
                    <separator string="Child nodes" />
                    <field name="child_ids" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isp_network_node_search" model="ir.ui.view">
        <field name="name">isp.network.node.search</field>
        <field name="model">isp.network.node</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="node_type" />
                <filter
                    string="Fiber (GPON)"
                    name="fiber"
                    domain="[('node_type', '=', 'fiber')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Node type"
                        name="group_type"
                        context="{'group_by': 'node_type'}"
                    />
                    <filter
                        string="City"
                        name="group_city"
                        context="{'group_by': 'city_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_isp_network_node" model="ir.actions.act_window">
        <field name="name">Network Nodes</field>
        <field name="res_model">isp.network.node</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_isp_root"
        name="ISP"
        web_icon="isp_network_node,static/description/icon.png"
        sequence="100"
        groups="base.group_user"
    />

    <menuitem
        id="menu_isp_infrastructure"
        name="Infraestructura"
        parent="menu_isp_root"
        sequence="10"
    />

    <menuitem
        id="menu_isp_commercial"
        name="Comercial"
        parent="menu_isp_root"
        sequence="20"
    />

    <menuitem
        id="menu_isp_network_node"
        name="Nodes"
        parent="menu_isp_infrastructure"
        action="action_isp_network_node"
        sequence="10"
    />
</odoo>
