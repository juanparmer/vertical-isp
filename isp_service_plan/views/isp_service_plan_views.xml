<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_isp_plan_extra_tree" model="ir.ui.view">
        <field name="name">isp.plan.extra.tree</field>
        <field name="model">isp.plan.extra</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="product_id" />
                <field name="plan_id" />
            </list>
        </field>
    </record>

    <record id="action_isp_plan_extra" model="ir.actions.act_window">
        <field name="name">Additional Products</field>
        <field name="res_model">isp.plan.extra</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_plan_id': active_id}</field>
    </record>

    <menuitem
        id="menu_isp_plan_extra"
        name="Additional Products"
        parent="isp_network_node.menu_isp_commercial"
        action="action_isp_plan_extra"
        sequence="20"
    />
</odoo>
