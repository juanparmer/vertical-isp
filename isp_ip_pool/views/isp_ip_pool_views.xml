<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_isp_ip_pool_tree" model="ir.ui.view">
        <field name="name">isp.ip.pool.tree</field>
        <field name="model">isp.ip.pool</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="network_address" />
                <field name="ip_version" />
                <field name="node_id" />
                <field name="address_count" />
                <field name="address_free_count" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_isp_ip_pool_form" model="ir.ui.view">
        <field name="name">isp.ip.pool.form</field>
        <field name="model">isp.ip.pool</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate_addresses"
                        type="object"
                        string="Generate addresses"
                        class="oe_highlight"
                    />
                    <field name="active" invisible="1" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="network_address" />
                            <field name="ip_version" />
                            <field name="node_id" />
                            <field name="partner_id" />
                            <field name="state" />
                        </group>
                        <group>
                            <field name="gateway" />
                            <field name="dns1" />
                            <field name="dns2" />
                            <field name="address_count" />
                            <field name="address_free_count" />
                        </group>
                    </group>
                    <separator string="Addresses" />
                    <field name="address_ids">
                        <list editable="bottom">
                            <field name="ip_address" />
                            <field name="state" />
                            <field name="partner_id" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isp_ip_pool_search" model="ir.ui.view">
        <field name="name">isp.ip.pool.search</field>
        <field name="model">isp.ip.pool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="network_address" />
                <filter string="IPv4" name="v4" domain="[('ip_version', '=', 'v4')]" />
                <filter string="IPv6" name="v6" domain="[('ip_version', '=', 'v6')]" />
                <group expand="0" string="Group By">
                    <filter
                        string="Node"
                        name="group_node"
                        context="{'group_by': 'node_id'}"
                    />
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_isp_ip_pool" model="ir.actions.act_window">
        <field name="name">IP Pools</field>
        <field name="res_model">isp.ip.pool</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', True)]</field>
    </record>

    <record id="view_isp_ip_address_tree" model="ir.ui.view">
        <field name="name">isp.ip.address.tree</field>
        <field name="model">isp.ip.address</field>
        <field name="arch" type="xml">
            <list>
                <field name="ip_address" />
                <field name="pool_id" />
                <field name="state" />
                <field name="partner_id" />
            </list>
        </field>
    </record>

    <record id="action_isp_ip_address" model="ir.actions.act_window">
        <field name="name">IP Addresses</field>
        <field name="res_model">isp.ip.address</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_isp_ip_pool"
        name="IP Pools"
        parent="isp_network_node.menu_isp_infrastructure"
        action="action_isp_ip_pool"
        sequence="20"
    />

    <menuitem
        id="menu_isp_ip_address"
        name="IP Addresses"
        parent="isp_network_node.menu_isp_infrastructure"
        action="action_isp_ip_address"
        sequence="30"
    />
</odoo>
