<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_isp_suspension_event_tree" model="ir.ui.view">
        <field name="name">isp.suspension.event.tree</field>
        <field name="model">isp.suspension.event</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="partner_id" />
                <field name="event_type" />
                <field name="state" decoration-danger="state == 'error'" />
                <field name="execute_date" />
                <field name="executed_by" />
                <field name="onu_serial" />
            </list>
        </field>
    </record>

    <record id="view_isp_suspension_event_form" model="ir.ui.view">
        <field name="name">isp.suspension.event.form</field>
        <field name="model">isp.suspension.event</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="partner_id" />
                            <field name="event_type" />
                            <field name="state" />
                        </group>
                        <group>
                            <field name="onu" />
                            <field name="onu_serial" />
                            <field name="olt_id" />
                            <field name="execute_date" />
                            <field name="executed_by" />
                        </group>
                    </group>
                    <separator string="Error" />
                    <field
                        name="error_message"
                        invisible="state != 'error'"
                    />
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isp_suspension_event_search" model="ir.ui.view">
        <field name="name">isp.suspension.event.search</field>
        <field name="model">isp.suspension.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="onu_serial" />
                <filter
                    string="Errors"
                    name="errors"
                    domain="[('state', '=', 'error')]"
                />
                <filter
                    string="Cutoffs"
                    name="cutoffs"
                    domain="[('event_type', 'in', ('cutoff', 'manual_suspend'))]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Event type"
                        name="group_type"
                        context="{'group_by': 'event_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_isp_suspension_event" model="ir.actions.act_window">
        <field name="name">Suspension Events</field>
        <field name="res_model">isp.suspension.event</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_isp_suspensions"
        name="Suspensions"
        parent="isp_network_node.menu_isp_root"
        action="action_isp_suspension_event"
        sequence="30"
    />
</odoo>
